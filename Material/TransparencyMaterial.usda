#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (494.60.2)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    reorder nameChildren = ["DefaultMaterial", "DefaultMaterial"]
    def Material "TransparencyMaterial"
    {
        token cullMode = "front" (
            allowedTokens = ["unspecified", "none", "front", "back"]
        )
        token outputs:mtlx:surface.connect = </Root/TransparencyMaterial/UnlitSurface.outputs:out>
        token outputs:realitykit:vertex
        token outputs:surface.connect = None
        float2 ui:nodegraph:node:pos = (20, 20)
        int ui:nodegraph:node:stackingOrder = 1
        float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (-61.92622, 45.60986)
        int ui:nodegraph:realitykit:subgraphOutputs:stackingOrder = 603

        def Shader "DefaultSurfaceShader" (
            active = false
        )
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            float inputs:roughness = 0.75
            token outputs:surface
        }

        def Shader "UnlitSurface"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            bool inputs:applyPostProcessToneMap = 1
            color3f inputs:color = (0.46202266, 0.8382837, 1) (
                colorSpace = "srgb_texture"
            )
            bool inputs:hasPremultipliedAlpha = 0
            float inputs:opacity.connect = </Root/TransparencyMaterial/IfGreater_1.outputs:out>
            float inputs:opacityThreshold
            token outputs:out
            float2 ui:nodegraph:node:pos = (-314.71484, 85.16797)
            int ui:nodegraph:node:stackingOrder = 601
        }

        def Shader "Position"
        {
            uniform token info:id = "ND_position_vector3"
            string inputs:space = "object"
            float3 outputs:out
            float2 ui:nodegraph:node:pos = (-1212.9774, 210.10724)
            int ui:nodegraph:node:stackingOrder = 621
        }

        def Shader "Separate3"
        {
            uniform token info:id = "ND_separate3_vector3"
            float3 inputs:in.connect = </Root/TransparencyMaterial/Position.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float2 ui:nodegraph:node:pos = (-974.9005, 209.06288)
            int ui:nodegraph:node:stackingOrder = 619
        }

        def Shader "Normal"
        {
            uniform token info:id = "ND_normal_vector3"
            float3 outputs:out
            float2 ui:nodegraph:node:pos = (-989.88885, 7.2672153)
            int ui:nodegraph:node:stackingOrder = 613
        }

        def Shader "Separate3_1"
        {
            uniform token info:id = "ND_separate3_vector3"
            float3 inputs:in.connect = </Root/TransparencyMaterial/Normal.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float2 ui:nodegraph:node:pos = (-780.4193, 15.100677)
            int ui:nodegraph:node:stackingOrder = 609
        }

        def Shader "SmoothStep"
        {
            uniform token info:id = "ND_smoothstep_float"
            float inputs:high = 0
            float inputs:in.connect = </Root/TransparencyMaterial/Separate3.outputs:outy>
            float inputs:low = 0.1
            float outputs:out
            float2 ui:nodegraph:node:pos = (-763.3389, 339.68057)
            int ui:nodegraph:node:stackingOrder = 617
        }

        def Shader "Remap"
        {
            uniform token info:id = "ND_remap_float"
            float inputs:in.connect = </Root/TransparencyMaterial/Separate3.outputs:outy>
            float inputs:inhigh = -0.1
            float inputs:inlow = 0.05
            float inputs:outhigh = 0.8
            float inputs:outlow
            float outputs:out
            float2 ui:nodegraph:node:pos = (-759.6408, 151.08582)
            int ui:nodegraph:node:stackingOrder = 611
            string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["inputs:inhigh", "inputs:inhigh"]
        }

        def Shader "IfGreater_1"
        {
            uniform token info:id = "ND_ifgreater_float"
            float inputs:in1 = 1
            float inputs:in1.connect = </Root/TransparencyMaterial/Remap.outputs:out>
            float inputs:in2 = 0.5
            float inputs:value1 = 0.5
            float inputs:value2 = 0.5
            float inputs:value2.connect = </Root/TransparencyMaterial/Separate3_1.outputs:outy>
            float outputs:out
            float2 ui:nodegraph:node:pos = (-546.58374, 73.24323)
            int ui:nodegraph:node:stackingOrder = 605
            string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["outputs:out"]
        }
    }
}

